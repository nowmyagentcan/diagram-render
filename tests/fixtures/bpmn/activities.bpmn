<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="activities" targetNamespace="http://example.com/bpmn">
  <bpmn:process id="activities_process" isExecutable="false">
    <bpmn:task id="t0" name="Plain task" />
    <bpmn:userTask id="t1" name="Approve the request" />
    <bpmn:serviceTask id="t2" name="Call the service" />
    <bpmn:scriptTask id="t3" name="Run the script" />
    <bpmn:sendTask id="t4" name="Send the invoice" />
    <bpmn:receiveTask id="t5" name="Wait for payment" />
    <bpmn:manualTask id="t6" name="Pack by hand" />
    <bpmn:businessRuleTask id="t7" name="Decide the discount" />
    <bpmn:task id="m0" name="Task with loop"><bpmn:standardLoopCharacteristics /></bpmn:task>
    <bpmn:task id="m1" name="Task with parallel"><bpmn:multiInstanceLoopCharacteristics /></bpmn:task>
    <bpmn:task id="m2" name="Task with sequential"><bpmn:multiInstanceLoopCharacteristics isSequential="true" /></bpmn:task>
    <bpmn:task id="m3" name="Task with compensation" isForCompensation="true"></bpmn:task>
    <bpmn:task id="m4" name="Task with loop and compensation" isForCompensation="true"><bpmn:standardLoopCharacteristics /></bpmn:task>
    <bpmn:callActivity id="call" name="Call a process" />
    <bpmn:callActivity id="callx" name="Collapsed call" calledElement="other" />
    <bpmn:subProcess id="sub" name="Collapsed sub-process" />
    <bpmn:adHocSubProcess id="adhoc" name="Ad-hoc work" />
    <bpmn:subProcess id="subloop" name="Repeated sub-process"><bpmn:multiInstanceLoopCharacteristics isSequential="true" /></bpmn:subProcess>
    <bpmn:subProcess id="evsubc" name="On cancel" triggeredByEvent="true"><bpmn:startEvent id="evsubc_s" isInterrupting="false"><bpmn:messageEventDefinition /></bpmn:startEvent></bpmn:subProcess>
    <bpmn:subProcess id="subx" name="Expanded sub-process">
      <bpmn:startEvent id="subx_s" />
      <bpmn:task id="subx_t" name="Inner task" />
      <bpmn:endEvent id="subx_e" />
      <bpmn:sequenceFlow id="subx_f1" sourceRef="subx_s" targetRef="subx_t" />
      <bpmn:sequenceFlow id="subx_f2" sourceRef="subx_t" targetRef="subx_e" />
    </bpmn:subProcess>
    <bpmn:transaction id="tx" name="Book the trip" />
    <bpmn:subProcess id="evsub" name="Handle a timeout" triggeredByEvent="true"><bpmn:startEvent id="evsub_s" name="Timed out"><bpmn:timerEventDefinition /></bpmn:startEvent></bpmn:subProcess>
    <bpmn:exclusiveGateway id="gw" name="Paid?" default="f_default" />
    <bpmn:task id="ft1" name="Ship it" default="f_task_default" />
    <bpmn:task id="ft2" name="Remind" />
    <bpmn:task id="ft3" name="Close" />
    <bpmn:sequenceFlow id="f_plain" name="yes" sourceRef="gw" targetRef="ft1" />
    <bpmn:sequenceFlow id="f_default" sourceRef="gw" targetRef="ft2" />
    <bpmn:sequenceFlow id="f_cond" name="late" sourceRef="ft1" targetRef="ft2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">late</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_task_default" sourceRef="ft1" targetRef="ft3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="activities_diagram" name="Activities">
    <bpmndi:BPMNPlane id="activities_diagram_plane" bpmnElement="activities_process">
      <bpmndi:BPMNShape id="t0_di" bpmnElement="t0">
        <dc:Bounds x="160" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1">
        <dc:Bounds x="300" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2">
        <dc:Bounds x="440" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3">
        <dc:Bounds x="580" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4">
        <dc:Bounds x="720" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5">
        <dc:Bounds x="860" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6">
        <dc:Bounds x="1000" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_di" bpmnElement="t7">
        <dc:Bounds x="1140" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m0_di" bpmnElement="m0">
        <dc:Bounds x="160" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m1_di" bpmnElement="m1">
        <dc:Bounds x="300" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m2_di" bpmnElement="m2">
        <dc:Bounds x="440" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m3_di" bpmnElement="m3">
        <dc:Bounds x="580" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m4_di" bpmnElement="m4">
        <dc:Bounds x="720" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="call_di" bpmnElement="call">
        <dc:Bounds x="860" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="callx_di" bpmnElement="callx" isExpanded="false">
        <dc:Bounds x="1000" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_di" bpmnElement="sub" isExpanded="false">
        <dc:Bounds x="160" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="adhoc_di" bpmnElement="adhoc" isExpanded="false">
        <dc:Bounds x="300" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="subloop_di" bpmnElement="subloop" isExpanded="false">
        <dc:Bounds x="440" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evsubc_di" bpmnElement="evsubc" isExpanded="false">
        <dc:Bounds x="580" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="subx_di" bpmnElement="subx" isExpanded="true">
        <dc:Bounds x="160" y="500" width="350" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="subx_s_di" bpmnElement="subx_s">
        <dc:Bounds x="192" y="582" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="subx_t_di" bpmnElement="subx_t">
        <dc:Bounds x="280" y="560" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="subx_e_di" bpmnElement="subx_e">
        <dc:Bounds x="432" y="582" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="subx_f1_di" bpmnElement="subx_f1">
        <di:waypoint x="228" y="600" />
        <di:waypoint x="280" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="subx_f2_di" bpmnElement="subx_f2">
        <di:waypoint x="380" y="600" />
        <di:waypoint x="432" y="600" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="tx_di" bpmnElement="tx" isExpanded="true">
        <dc:Bounds x="560" y="500" width="250" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evsub_di" bpmnElement="evsub" isExpanded="true">
        <dc:Bounds x="860" y="500" width="250" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="evsub_s_di" bpmnElement="evsub_s">
        <dc:Bounds x="892" y="582" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="886" y="625" width="49" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_di" bpmnElement="gw" isMarkerVisible="true">
        <dc:Bounds x="185" y="795" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="196" y="775" width="29" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ft1_di" bpmnElement="ft1">
        <dc:Bounds x="320" y="780" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ft2_di" bpmnElement="ft2">
        <dc:Bounds x="320" y="920" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ft3_di" bpmnElement="ft3">
        <dc:Bounds x="520" y="780" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_plain_di" bpmnElement="f_plain">
        <di:waypoint x="235" y="820" />
        <di:waypoint x="320" y="820" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="269" y="802" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_default_di" bpmnElement="f_default">
        <di:waypoint x="210" y="845" />
        <di:waypoint x="210" y="960" />
        <di:waypoint x="320" y="960" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_cond_di" bpmnElement="f_cond">
        <di:waypoint x="370" y="860" />
        <di:waypoint x="370" y="920" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="380" y="883" width="19" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_task_default_di" bpmnElement="f_task_default">
        <di:waypoint x="420" y="820" />
        <di:waypoint x="520" y="820" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
