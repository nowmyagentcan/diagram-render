<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="colours" targetNamespace="http://example.com/bpmn">
  <bpmn:process id="colour_process" isExecutable="false">
    <bpmn:startEvent id="k_start" name="Green start" />
    <bpmn:userTask id="k_task" name="Blue task" />
    <bpmn:exclusiveGateway id="k_gw" name="Orange gateway" />
    <bpmn:task id="k_omg" name="Purple task" />
    <bpmn:endEvent id="k_end" name="Red end" />
    <bpmn:sequenceFlow id="k_f1" sourceRef="k_start" targetRef="k_task" />
    <bpmn:sequenceFlow id="k_f2" sourceRef="k_task" targetRef="k_gw" />
    <bpmn:sequenceFlow id="k_f3" sourceRef="k_gw" targetRef="k_omg" />
    <bpmn:sequenceFlow id="k_f4" sourceRef="k_omg" targetRef="k_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="colour_diagram" name="Colours">
    <bpmndi:BPMNPlane id="colour_diagram_plane" bpmnElement="colour_process">
      <bpmndi:BPMNShape id="k_start_di" bpmnElement="k_start" bioc:stroke="#205022" bioc:fill="#c8e6c9">
        <dc:Bounds x="172" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel color:color="#205022">
          <dc:Bounds x="160" y="145" width="59" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="k_task_di" bpmnElement="k_task" bioc:stroke="#0d4372" bioc:fill="#bbdefb">
        <dc:Bounds x="260" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="k_gw_di" bpmnElement="k_gw" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2">
        <dc:Bounds x="415" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel color:color="#6b3c00">
          <dc:Bounds x="400" y="152" width="81" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="k_omg_di" bpmnElement="k_omg" color:background-color="#e1bee7" color:border-color="#5b2a6e">
        <dc:Bounds x="520" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="k_end_di" bpmnElement="k_end" bioc:stroke="#831311" bioc:fill="#ffcdd2">
        <dc:Bounds x="672" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel color:color="#831311">
          <dc:Bounds x="668" y="145" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="k_f1_di" bpmnElement="k_f1" bioc:stroke="#205022">
        <di:waypoint x="208" y="120" />
        <di:waypoint x="260" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="k_f2_di" bpmnElement="k_f2" bioc:stroke="#0d4372">
        <di:waypoint x="360" y="120" />
        <di:waypoint x="415" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="k_f3_di" bpmnElement="k_f3" color:border-color="#6b3c00">
        <di:waypoint x="465" y="120" />
        <di:waypoint x="520" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="k_f4_di" bpmnElement="k_f4">
        <di:waypoint x="620" y="120" />
        <di:waypoint x="672" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
