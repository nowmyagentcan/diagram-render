<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="collaboration" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="collab">
    <bpmn:participant id="shop" name="Shop" processRef="shop_process" />
    <bpmn:participant id="customer" name="Customers">
      <bpmn:participantMultiplicity minimum="2" maximum="10" />
    </bpmn:participant>
    <bpmn:messageFlow id="mf_order" name="Order" sourceRef="customer" targetRef="take" />
    <bpmn:messageFlow id="mf_invoice" name="Invoice" sourceRef="bill" targetRef="customer" />
  </bpmn:collaboration>
  <bpmn:process id="shop_process" isExecutable="false">
    <bpmn:laneSet id="lanes">
      <bpmn:lane id="sales" name="Sales"><bpmn:flowNodeRef>take</bpmn:flowNodeRef><bpmn:flowNodeRef>start</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="accounts" name="Accounts"><bpmn:flowNodeRef>bill</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Order in" />
    <bpmn:receiveTask id="take" name="Take the order" />
    <bpmn:sendTask id="bill" name="Send the invoice" />
    <bpmn:endEvent id="end" name="Done" />
    <bpmn:sequenceFlow id="c_f1" sourceRef="start" targetRef="take" />
    <bpmn:sequenceFlow id="c_f2" sourceRef="take" targetRef="bill" />
    <bpmn:sequenceFlow id="c_f3" sourceRef="bill" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="collab_diagram" name="Collaboration">
    <bpmndi:BPMNPlane id="collab_diagram_plane" bpmnElement="collab">
      <bpmndi:BPMNShape id="shop_di" bpmnElement="shop" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="600" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sales_di" bpmnElement="sales" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="570" height="125" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="accounts_di" bpmnElement="accounts" isHorizontal="true">
        <dc:Bounds x="190" y="205" width="570" height="125" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="customer_di" bpmnElement="customer" isHorizontal="true">
        <dc:Bounds x="160" y="400" width="600" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="232" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="228" y="165" width="43" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="take_di" bpmnElement="take">
        <dc:Bounds x="320" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bill_di" bpmnElement="bill">
        <dc:Bounds x="480" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="652" y="247" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="655" y="290" width="30" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="c_f1_di" bpmnElement="c_f1">
        <di:waypoint x="268" y="140" />
        <di:waypoint x="320" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c_f2_di" bpmnElement="c_f2">
        <di:waypoint x="420" y="140" />
        <di:waypoint x="450" y="140" />
        <di:waypoint x="450" y="265" />
        <di:waypoint x="480" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="c_f3_di" bpmnElement="c_f3">
        <di:waypoint x="580" y="265" />
        <di:waypoint x="652" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_order_di" bpmnElement="mf_order">
        <di:waypoint x="370" y="400" />
        <di:waypoint x="370" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="377" y="353" width="30" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mf_invoice_di" bpmnElement="mf_invoice">
        <di:waypoint x="530" y="305" />
        <di:waypoint x="530" y="400" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="537" y="353" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
